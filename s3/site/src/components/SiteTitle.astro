---
import logo from '../assets/logo.svg';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="EspOS docs, home">
  <img src={logo.src} width="24" height="24" alt="" />
  <span class="word" translate="no">EspOS</span>
  <span class="tag">Docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    color: var(--sl-color-white);
  }
  img {
    height: 24px;
    width: 24px;
    flex: none;
  }
  .word {
    font-size: 1.05rem;
    font-weight: 650;
  }
  .tag {
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
</style>
