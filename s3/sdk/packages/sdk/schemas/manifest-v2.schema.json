{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espos.dev/schemas/manifest-v2.schema.json",
  "title": "EspOS package manifest v2 (DRAFT; the X4 firmware reads the decl subset)",
  "description": "The planned manifest v2 from s3/docs/platform.md (agreed 2026-11-17): package types, runtimes, API levels, screens, theme, the permission list version 1, entry points. No firmware reads these fields yet (firmware 0.5.0 = API level 1 reads the current format, manifest.schema.json). Field names may still change; do not ship packages that depend on them. Faces, widgets and themes with \"runtime\": \"decl\" are the exception: the X4 firmware reads them now (s3/docs/profiles.md §3-4).",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "code",
    "type",
    "runtime",
    "api"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9a-z.+-]{1,20}$"
    },
    "code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1999999999
    },
    "type": {
      "enum": [
        "app",
        "widget",
        "face",
        "theme",
        "service",
        "pack",
        "driver"
      ],
      "description": "app: full screen with a lifecycle; widget: home-screen card (declarative + data bindings); face: clock face / screen saver; theme: data only (colour tokens, wallpapers); service: short background job; pack: data for a native engine; driver: a plugged-in device's driver."
    },
    "runtime": {
      "enum": [
        "js",
        "wasm",
        "engine",
        "decl"
      ],
      "description": "decl: data only (JSON layouts drawn by the OS renderer), for face, widget and theme."
    },
    "api": {
      "type": "object",
      "required": [
        "min"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "description": "The lowest API level the package works with (the store hides it on devices below)."
        },
        "target": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "min_fw": {
      "type": "integer",
      "minimum": 0
    },
    "screens": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9]{2,4}x[0-9]{2,4}$"
          },
          {
            "enum": [
              "tiny",
              "small",
              "medium",
              "large",
              "round"
            ]
          }
        ]
      },
      "description": "Where the package can draw: exact sizes (320x480, 128x64) or size classes (tiny under 160 px, small 160-319, medium 320-479, large 480 and more, round). docs/app-slots.md §1.3."
    },
    "theme": {
      "enum": [
        "system",
        "custom"
      ],
      "default": "system"
    },
    "perms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "enum": [
              "bg",
              "dictate",
              "hw:*",
              "location:city",
              "mic",
              "net:*",
              "net:espos",
              "net:lan",
              "notify",
              "overlay",
              "remote",
              "screen.awake",
              "sound",
              "theme.write",
              "wifi.info"
            ]
          },
          {
            "type": "string",
            "pattern": "^net:[a-z0-9.-]+$"
          },
          {
            "type": "string",
            "pattern": "^storage:[0-9]+$"
          },
          {
            "type": "string",
            "pattern": "^data:(weather|calendar|markets|news|reading)$"
          },
          {
            "type": "string",
            "pattern": "^sensor:[a-z0-9_.]+$"
          },
          {
            "type": "string",
            "pattern": "^actuator:[a-z0-9_.]+$"
          },
          {
            "type": "string",
            "pattern": "^net:setting:[a-z][a-z0-9_]{0,23}$"
          },
          {
            "type": "string",
            "pattern": "^cache:[0-9]+$"
          },
          {
            "type": "string",
            "pattern": "^net:\\*\\.[a-z0-9.-]+$"
          }
        ]
      }
    },
    "entry": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "widget": {
          "type": "string"
        },
        "settings": {
          "type": "string"
        },
        "face": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "saver": {
          "type": "string"
        },
        "assistant": {
          "type": "string"
        }
      }
    },
    "category": {
      "enum": [
        "game",
        "tool",
        "study",
        "health",
        "widget"
      ]
    },
    "author": {
      "type": "string",
      "maxLength": 40
    },
    "desc": {
      "type": "string",
      "maxLength": 300
    },
    "icon": {
      "$ref": "manifest.schema.json#/properties/icon"
    },
    "addon_of": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,47}$"
    },
    "part": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,24}$"
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "description": "Capability names the device must report (s3/docs/profiles.md §1.1, src/hal/caps.h).",
      "items": {
        "enum": [
          "audio.in",
          "audio.out",
          "input.buttons",
          "input.touch",
          "led.rgb",
          "mem.psram",
          "net.ble",
          "net.wifi",
          "power.battery",
          "screen.color",
          "screen.eink",
          "screen.fast",
          "screen.gray",
          "store.sd",
          "screen.mono",
          "screen.tiny",
          "input.button"
        ]
      }
    },
    "refresh": {
      "enum": [
        "minute",
        "hour",
        "data",
        "day"
      ],
      "description": "decl faces: how often the OS redraws it at most."
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "saver",
          "assistant"
        ]
      },
      "description": "The slots the package can fill (docs/app-slots.md): it then appears in Settings › Default apps."
    },
    "settings": {
      "$ref": "settings.schema.json",
      "description": "The settings form, drawn by the device and the web; values sync as app.<id>.<key> (docs/manifest-driven.md §1)."
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "An https:// provider (docs/assistant-providers.md) or \"pawboop\"."
        },
        "picture": {
          "type": "string"
        },
        "picture_mono": {
          "type": "string"
        },
        "voice": {
          "type": "string",
          "maxLength": 60
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "provider"
      ],
      "description": "An assistant app's brain and look (docs/app-slots.md §5)."
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the server does for the app (docs/manifest-driven.md §2).",
      "properties": {
        "feeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "weather",
              "markets",
              "news",
              "calendar",
              "reading"
            ]
          }
        },
        "fetch": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "url",
              "every_min"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,23}$"
              },
              "url": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 500
              },
              "every_min": {
                "type": "integer",
                "minimum": 15,
                "maximum": 1440
              },
              "max_kb": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "pick": {
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^\\$"
                }
              }
            }
          }
        },
        "hooks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,23}$"
              },
              "popup": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "priority": {
                    "enum": [
                      "normal",
                      "high"
                    ]
                  }
                }
              }
            }
          }
        },
        "storage_kb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "unlocks": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,39}$"
      },
      "description": "Things a store may sell separately (\"full\", \"guppy\"); the OS checks <id>+<thing> (docs/app-slots.md §11.2)."
    },
    "auth": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,23}$"
      },
      "description": "Named bindings of secret settings to requests (docs/app-slots.md §15.1): JS passes auth: \"<name>\" to net.request.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "send_to"
        ],
        "properties": {
          "basic": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "bearer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,23}$"
          },
          "header": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 2,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            }
          },
          "query": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 4,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            }
          },
          "send_to": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^(https://[^\\s/?#]+|\\{[a-z][a-z0-9_]{0,23}\\})\\S*$",
              "maxLength": 300
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "basic"
            ]
          },
          {
            "required": [
              "bearer"
            ]
          },
          {
            "required": [
              "header"
            ]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "decl"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "face",
              "widget",
              "theme"
            ]
          }
        }
      },
      "else": {
        "required": [
          "min_fw"
        ]
      }
    }
  ]
}
