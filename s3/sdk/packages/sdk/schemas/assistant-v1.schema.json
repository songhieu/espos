       ]
      },
      "message": {
       "type": "string",
       "maxLength": 300
      },
      "retry_after_s": {
       "type": "integer",
       "minimum": 0
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "event": {
   "type": "object",
   "required": [
    "event",
