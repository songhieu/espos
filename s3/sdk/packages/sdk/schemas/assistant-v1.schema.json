        "$ref": "#/$defs/hhmm"
       },
       "days": {
        "$ref": "#/$defs/days"
       },
       "on": {
        "type": "boolean"
       },
       "label": {
        "type": "string",
        "maxLength": 60
       },
       "next": {
        "type": "string"
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
