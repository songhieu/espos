# The one account of this server (sign-in on the web).
INKDESK_USER=admin
INKDESK_PASSWORD=change-me-to-something-long

# Where the server listens, and where it keeps its database and files.
INKDESK_ADDR=:8080
INKDESK_DATA=./data

# Optional: the address the browser and the X4 use, when it is not what the server sees
# (behind a reverse proxy with HTTPS, for example).
# INKDESK_PUBLIC_URL=https://inkdesk.example.com
