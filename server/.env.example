# The one account of this server (sign-in on the web).
ESPOS_USER=admin
ESPOS_PASSWORD=change-me-to-something-long

# Where the server listens, and where it keeps its database and files.
ESPOS_ADDR=:8080
ESPOS_DATA=./data

# Optional: the address the browser and the X4 use, when it is not what the server sees
# (behind a reverse proxy with HTTPS, for example).
# ESPOS_PUBLIC_URL=https://espos.example.com

# ---- The dog assistant (README: "The dog assistant: AI and voice") ----
# The AI model: any OpenAI-style chat API. Default: Google Gemini (free key at https://aistudio.google.com/apikey).
# ESPOS_AI_KEY=
# ESPOS_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ESPOS_AI_MODEL=gemini-3.5-flash-lite
# ESPOS_AI_REASONING=          # low on Gemini when unset; "off" never sends it
# ESPOS_AI_JSON=1              # 0 if the API refuses response_format
# ESPOS_AI_PROMPT=             # short: the short prompt for a model on your own machine (README)
# ESPOS_AI_TIMEOUT=25          # seconds; 60 for a local model (its first answer reads the whole prompt)

# Optional speech-to-text, for a model that cannot hear a recording (e.g. Groq's free Whisper):
# ESPOS_STT_URL=https://api.groq.com/openai/v1
# ESPOS_STT_KEY=
# ESPOS_STT_MODEL=whisper-large-v3-turbo
# ESPOS_STT_LANG=vi

# The dog's voice: an OpenAI-style /audio/speech API, or a hosted-style /v1/tts (ESPOS_TTS_API=espos).
# Unset: the dog answers in words on the screen only.
# ESPOS_TTS_URL=https://api.openai.com/v1
# ESPOS_TTS_KEY=
# ESPOS_TTS_API=openai
# ESPOS_TTS_MODEL=gpt-4o-mini-tts
# ESPOS_TTS_VOICE=alloy
# ESPOS_TTS_FORMAT=pcm         # pcm (24 kHz, OpenAI's) or wav
# ESPOS_TTS_RATE=24000         # the rate of a pcm answer
