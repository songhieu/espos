{
  "code": "save_device_settings",
  "name": "Web: change a device settings",
  "draft": {
    "nodes": [
      {
        "id": "in",
        "type": "http_in"
      },
      {
        "id": "put",
        "type": "call_workflow",
        "config": {
          "workflow": "put_device_settings",
          "input": {
            "uid": "{{ input.user.id }}",
            "device_id": "{{ input.params.id }}",
            "changes": "{{ input.body.changes }}"
          }
        }
      },
      {
        "id": "out",
        "type": "respond",
        "config": {
          "status": "{{ put.status }}",
          "body": "{{ put.body }}"
        }
      },
      {
        "id": "fail",
        "type": "respond",
        "config": {
          "status": 500,
          "body": {
            "error": "{{ put.error }}"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "in",
        "to": "put"
      },
      {
        "from": "put",
        "to": "out"
      },
      {
        "from": "put",
        "to": "fail",
        "port": "error"
      }
    ]
  }
}
