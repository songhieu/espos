{
  "code": "confirm_user_pkg",
  "name": "Web and CLI: keep the user's uploaded package (checks the .espk with the validator's rules, makes its id private, a higher code replaces the old one) and ask their S3 devices for it",
  "draft": {
    "nodes": [
      { "id": "in", "type": "http_in" },
      { "id": "chk", "type": "code", "config": { "source": { "$file": "nodes/chk.go" }, "timeout_ms": 10000,
          "input": { "body": "{{ input.body }}", "uid": "{{ input.user.id }}", "auth": "{{ input.headers.authorization }}" } } },
      { "id": "isok", "type": "branch", "config": { "rules": [ { "left": "{{ chk.ok }}", "op": "eq", "right": true } ] } },
      { "id": "get", "type": "storage_get", "config": { "key": "{{ chk.key }}" } },
      { "id": "parse", "type": "code", "config": { "source": { "$file": "nodes/parse.go" }, "timeout_ms": 30000, "memory_mb": 512,
          "input": { "b64": "{{ get.content_base64 }}", "uid": "{{ chk.uid }}", "dir": "{{ chk.dir }}", "ms": "{{ chk.ms }}",
            "legacy_id": "{{ chk.legacy_id }}", "have": "{{ chk.have }}", "thumb": "{{ chk.thumb }}", "screen": "{{ chk.screen }}" } } },
      { "id": "pok", "type": "branch", "config": { "rules": [ { "left": "{{ parse.ok }}", "op": "eq", "right": true } ] } },
      { "id": "put", "type": "storage_put", "config": { "key": "{{ parse.final_key }}", "content_base64": "{{ parse.b64 }}" } },
      { "id": "hasic", "type": "branch", "config": { "rules": [ { "left": "{{ parse.has_icon }}", "op": "eq", "right": true } ] } },
      { "id": "iput", "type": "storage_put", "config": { "key": "{{ parse.icon_key }}", "content_base64": "{{ parse.icon_b64 }}" } },
      { "id": "keep", "type": "code", "config": { "source": { "$file": "nodes/keep.go" }, "timeout_ms": 20000, "any_owner": true,
          "input": { "uid": "{{ chk.uid }}", "upload_dir": "{{ chk.dir }}", "pkg_id": "{{ parse.pkg_id }}", "src_id": "{{ parse.src_id }}",
            "name": "{{ parse.name }}", "version": "{{ parse.version }}", "code": "{{ parse.code }}", "engine": "{{ parse.engine }}",
            "size": "{{ parse.size }}", "sha256": "{{ parse.sha256 }}", "final_key": "{{ parse.final_key }}",
            "has_icon": "{{ parse.has_icon }}", "icon_key": "{{ parse.icon_key }}", "thumb": "{{ parse.thumb }}", "meta": "{{ parse.meta }}",
            "renamed": "{{ parse.renamed }}", "old_id": "{{ parse.old_id }}", "old_code": "{{ parse.old_code }}" } } },
      { "id": "push", "type": "call_workflow", "config": { "workflow": "push_user_pkg",
          "input": { "uid": "{{ chk.uid }}", "pkg_id": "{{ parse.pkg_id }}", "code": "{{ parse.code }}", "min_fw": "{{ parse.min_fw }}",
            "devices": "{{ chk.install }}" } } },
      { "id": "out", "type": "respond", "config": { "status": 200, "body": { "pkg": "{{ keep.pkg }}", "replaced": "{{ keep.replaced }}", "devices": "{{ push.devices }}" } } },
      { "id": "outp", "type": "respond", "config": { "status": 200, "body": { "pkg": "{{ keep.pkg }}", "replaced": "{{ keep.replaced }}", "devices": [], "devices_error": "{{ push.error }}" } } },
      { "id": "bad", "type": "respond", "config": { "status": "{{ chk.status }}", "body": { "error": "{{ chk.why }}", "code": "{{ chk.code }}", "params": "{{ chk.params }}" } } },
      { "id": "bad2", "type": "respond", "config": { "status": "{{ parse.status }}", "body": "{{ parse.body }}" } },
      { "id": "nofile", "type": "respond", "config": { "status": 409, "body": { "error": "Máy chủ chưa đọc được file. Thử tải lại.", "code": "pkg_missing_file" } } },
      { "id": "fail", "type": "respond", "config": { "status": 500, "body": { "error": "{{ chk.error }}" } } },
      { "id": "fail2", "type": "respond", "config": { "status": 500, "body": { "error": "{{ parse.error }}" } } },
      { "id": "fail3", "type": "respond", "config": { "status": 500, "body": { "error": "{{ put.error }}" } } },
      { "id": "fail4", "type": "respond", "config": { "status": 500, "body": { "error": "{{ iput.error }}" } } },
      { "id": "fail5", "type": "respond", "config": { "status": 500, "body": { "error": "{{ keep.error }}" } } }
    ],
    "edges": [
      { "from": "in", "to": "chk" },
      { "from": "chk", "to": "isok" },
      { "from": "chk", "to": "fail", "port": "error" },
      { "from": "isok", "to": "get", "port": "true" },
      { "from": "isok", "to": "bad", "port": "false" },
      { "from": "get", "to": "parse" },
      { "from": "get", "to": "nofile", "port": "error" },
      { "from": "parse", "to": "pok" },
      { "from": "parse", "to": "fail2", "port": "error" },
      { "from": "pok", "to": "put", "port": "true" },
      { "from": "pok", "to": "bad2", "port": "false" },
      { "from": "put", "to": "hasic" },
      { "from": "put", "to": "fail3", "port": "error" },
      { "from": "hasic", "to": "iput", "port": "true" },
      { "from": "hasic", "to": "keep", "port": "false" },
      { "from": "iput", "to": "keep" },
      { "from": "iput", "to": "fail4", "port": "error" },
      { "from": "keep", "to": "push" },
      { "from": "keep", "to": "fail5", "port": "error" },
      { "from": "push", "to": "out" },
      { "from": "push", "to": "outp", "port": "error" }
    ]
  }
}
