{
  "code": "assist_sweep",
  "name": "Schedule: the dog assistant forgets old talk (raw turns after 24 hours, session summaries after 7 days)",
  "draft": {
    "nodes": [
      {
        "id": "tick",
        "type": "schedule_trigger",
        "config": {
          "expression": "23 * * * *"
        }
      },
      {
        "id": "work",
        "type": "code",
        "config": {
          "source": {
            "$file": "nodes/work.go"
          },
          "timeout_ms": 30000,
          "input": {}
        }
      },
      {
        "id": "done",
        "type": "respond",
        "config": {
          "status": 200,
          "body": "{{ work }}"
        }
      }
    ],
    "edges": [
      {
        "from": "tick",
        "to": "work"
      },
      {
        "from": "work",
        "to": "done"
      }
    ]
  }
}
