{
  "code": "assist_reply",
  "name": "Dog assistant: one turn (hear, answer in the dog's voice, remember)",
  "draft": {
    "nodes": [
      {
        "id": "in",
        "type": "function_in",
        "config": {
          "inputs": [
            "device_id",
            "user_id",
            "source"
          ],
          "optional": [
            "text",
            "audio",
            "cid",
            "dog",
            "wake",
            "intent",
            "v1"
          ]
        }
      },
      {
        "id": "talk",
        "type": "code",
        "config": {
          "source": {
            "$file": "nodes/talk.go"
          },
          "timeout_ms": 50000,
          "memory_mb": 384,
          "input": {
            "device_id": "{{ input.device_id }}",
            "user_id": "{{ input.user_id }}",
            "source": "{{ input.source }}",
            "text": "{{ input.text }}",
            "audio": "{{ input.audio }}",
            "cid": "{{ input.cid }}",
            "dog": "{{ input.dog }}",
            "wake": "{{ input.wake }}",
            "intent": "{{ input.intent }}",
            "desk_on": "{{ var.desktop_enabled }}",
            "v1": "{{ input.v1 }}",
            "providers_on": "{{ var.ai_providers_enabled }}"
          }
        }
      },
      {
        "id": "out",
        "type": "return",
        "config": {
          "data": {
            "status": "{{ talk.status }}",
            "body": "{{ talk.body }}",
            "changes": "{{ talk.changes }}",
            "n_changes": "{{ talk.n_changes }}",
            "oops": "{{ talk.oops }}",
            "facts": "{{ talk.facts }}",
            "unclear": "{{ talk.unclear }}"
          }
        }
      },
      {
        "id": "boom",
        "type": "return",
        "config": {
          "data": {
            "status": 500,
            "body": {
              "error": "{{ talk.error }}"
            }
          }
        }
      },
      {
        "id": "route",
        "type": "branch",
        "config": {
          "rules": [
            {
              "left": "{{ talk.route }}",
              "op": "eq",
              "right": "provider"
            }
          ]
        }
      },
      {
        "id": "prov",
        "type": "call_workflow",
        "config": {
          "workflow": "provider_call",
          "input": {
            "pkg": "{{ talk.pkg }}",
            "req": "{{ talk.req }}",
            "user_id": "{{ input.user_id }}",
            "device_id": "{{ input.device_id }}"
          }
        }
      },
      {
        "id": "pol",
        "type": "code",
        "config": {
          "source": {
            "$file": "nodes/talk.go"
          },
          "timeout_ms": 20000,
          "memory_mb": 384,
          "input": {
            "device_id": "{{ input.device_id }}",
            "user_id": "{{ input.user_id }}",
            "source": "{{ input.source }}",
            "text": "{{ input.text }}",
            "audio": "{{ input.audio }}",
            "cid": "{{ input.cid }}",
            "dog": "{{ input.dog }}",
            "wake": "{{ input.wake }}",
            "intent": "{{ input.intent }}",
            "desk_on": "{{ var.desktop_enabled }}",
            "v1": "{{ input.v1 }}",
            "providers_on": "{{ var.ai_providers_enabled }}",
            "mode": "policy",
            "req": "{{ talk.req }}",
            "internal": "{{ talk.internal }}",
            "provider": "{{ prov }}"
          }
        }
      },
      {
        "id": "outp",
        "type": "return",
        "config": {
          "data": {
            "status": "{{ pol.status }}",
            "body": "{{ pol.body }}",
            "changes": "{{ pol.changes }}",
            "n_changes": "{{ pol.n_changes }}",
            "oops": "{{ pol.oops }}",
            "facts": "{{ pol.facts }}",
            "unclear": "{{ pol.unclear }}"
          }
        }
      },
      {
        "id": "boomp",
        "type": "return",
        "config": {
          "data": {
            "status": 500,
            "body": {
              "error": "{{ pol.error }}"
            }
          }
        }
      },
      {
        "id": "boomc",
        "type": "return",
        "config": {
          "data": {
            "status": 502,
            "body": {
              "error": "provider_failed",
              "provider_error": "call"
            }
          }
        }
      }
    ],
    "edges": [
      {
        "from": "in",
        "to": "talk"
      },
      {
        "from": "talk",
        "to": "boom",
        "port": "error"
      },
      {
        "from": "talk",
        "to": "route"
      },
      {
        "from": "route",
        "to": "prov",
        "port": "true"
      },
      {
        "from": "route",
        "to": "out",
        "port": "false"
      },
      {
        "from": "prov",
        "to": "pol"
      },
      {
        "from": "prov",
        "to": "boomc",
        "port": "error"
      },
      {
        "from": "pol",
        "to": "outp"
      },
      {
        "from": "pol",
        "to": "boomp",
        "port": "error"
      }
    ]
  }
}
